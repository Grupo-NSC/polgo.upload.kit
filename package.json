{
  "name": "polgo-upload-kit",
  "version": "2.0.0",
  "type": "module",
  "main": "./dist/polgoUploadClient.js",
  "types": "./dist/polgoUploadClient.d.ts",
  "exports": {
    ".": {
      "types": "./dist/polgoUploadClient.d.ts",
      "import": "./dist/polgoUploadClient.js"
    },
    "./src/polgoUploadClient": {
      "types": "./dist/polgoUploadClient.d.ts",
      "import": "./dist/polgoUploadClient.js"
    },
    "./src/polgoUploadClient.js": {
      "types": "./dist/polgoUploadClient.d.ts",
