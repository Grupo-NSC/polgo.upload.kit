  },
  "homepage": "https://github.com/Grupo-NSC/polgo-upload-kit#readme",
  "dependencies": {
    "axios": "^1.7.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.2"
  }
